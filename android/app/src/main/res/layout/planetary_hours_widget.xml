<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ph_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cosmic_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Current Planetary Hour -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ph_symbol"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/cosmic_pill_bg"
            android:gravity="center"
            android:text="♀"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7LAYERS • ANLIK GEZEGEN SAATİ"
                android:textColor="#D4AF37"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ph_current_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Venüs ♀ Saati Aktif"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ph_mins_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cosmic_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="32 dk kaldı"
            android:textColor="#FDE68A"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Current Hour Esoteric Meaning -->
    <TextView
        android:id="@+id/ph_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Uyum, sevgi, estetik, sanat, barışma ve sosyal ilişkileri güçlendirmek için en elverişli kozmik saat."
        android:textColor="#E5E7EB"
        android:textSize="11sp" />

    <!-- Bottom 3 Upcoming Hours Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/cosmic_inner_card_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/ph_next1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sıradaki 1."
                android:textColor="#9CA3AF"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/ph_next1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merkür ☿"
                android:textColor="#FDE68A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/cosmic_inner_card_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/ph_next2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sıradaki 2."
                android:textColor="#9CA3AF"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/ph_next2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ay ☽"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/cosmic_inner_card_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/ph_next3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sıradaki 3."
                android:textColor="#9CA3AF"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/ph_next3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Satürn ♄"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

