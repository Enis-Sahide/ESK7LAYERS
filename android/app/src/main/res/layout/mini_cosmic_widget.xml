<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cosmic_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="9dp"
    android:paddingVertical="6dp">

    <!-- Top Row: Active Planet Symbol + Name & Mins Left + Moon Phase -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mini_planet_symbol"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/cosmic_pill_bg"
            android:gravity="center"
            android:text="♄"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_hour_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="Satürn • 42dk"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_moon_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:singleLine="true"
            android:text="🌒 %40"
            android:textColor="#93C5FD"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Row: Previous Planetary Hour & Next Planetary Hour -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/cosmic_inner_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/mini_prev_hour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:text="◀ Ay ☽"
            android:textColor="#9CA3AF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_next_hour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:singleLine="true"
            android:text="Jüpiter ♃ ▶"
            android:textColor="#FDE68A"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
