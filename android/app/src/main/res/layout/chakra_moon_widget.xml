<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cm_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cosmic_widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Top Header: Daily Chakra + Moon Phase Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cm_moon_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/cosmic_inner_card_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="🌖"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cm_chakra_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="GÜNÜN ÇAKRASI • 396 HZ"
                android:textColor="#D4AF37"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cm_chakra_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="12.5sp"
                android:autoSizeMinTextSize="8.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="1. Katman: Kök Çakra (Muladhara)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/cm_moon_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cosmic_pill_bg"
            android:includeFontPadding="false"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="%68 Ay"
            android:textColor="#FDE68A"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Middle Card: Daily Affirmation Quote -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/cosmic_inner_card_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="✨ GÜNÜN OLUMLAMASI &amp; REZONANSI"
            android:textColor="#FDE68A"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cm_affirmation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8.5sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="&quot;Yaşamın sarsılmaz kökleriyle güvendeyim; toprağın gücü ve cesareti her hücremde akıyor.&quot;"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Bottom Row: Moon Phase Name + Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cm_moon_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="🌙 Küçülen Şişkin Ay: İçgörü ve denge zamanı"
            android:textColor="#7DD3FC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cm_open_freq_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Frekans Odası →"
            android:textColor="#D4AF37"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
