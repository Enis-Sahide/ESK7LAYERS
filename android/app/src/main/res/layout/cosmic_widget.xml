<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cosmic_widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="9dp"
    android:paddingVertical="6dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_symbol"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/cosmic_pill_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="♂"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="7LAYERS • KOZMİK PUSULA"
                android:textColor="#D4AF37"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="11.5sp"
                android:autoSizeMinTextSize="8.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Salı • Mars Günü • Kök Çakra (396 Hz)"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/cosmic_inner_card_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↻"
            android:textColor="#FDE68A"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Compact Middle 2-Column Split (Planetary Hour + Moon Phase) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Card: Active Planetary Hour (Compact 2-line) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/cosmic_inner_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/widget_hour_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="10.5sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="🪐 Venüs ♀ (34 dk)"
                android:textColor="#FDE68A"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_hour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeMinTextSize="7.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Sıradaki: Merkür ☿"
                android:textColor="#9CA3AF"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Right Card: Live Moon Phase (Compact 2-line) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/cosmic_inner_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/widget_moon_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="10.5sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="🌖 Küçülen Ay (%68)"
                android:textColor="#7DD3FC"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_moon_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:autoSizeMaxTextSize="9sp"
                android:autoSizeMinTextSize="7.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="İçgörü ve şükür evresi"
                android:textColor="#9CA3AF"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Expanded Bottom Guidance Card (Equal 50/50 Auto-Sizing Split so neither line ever clips) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/cosmic_inner_card_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_guidance"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="✓ Önerilen: Cesaret, fiziksel hareket ve yeni başlangıç adımları"
            android:textColor="#34D399"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_avoid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="10.5sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="✗ Kaçının: Ani öfke, aceleci tartışma ve dürtüsel çatışmalar"
            android:textColor="#F87171"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
