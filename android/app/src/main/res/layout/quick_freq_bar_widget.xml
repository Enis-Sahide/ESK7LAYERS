<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qfb_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cosmic_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="9dp"
    android:paddingVertical="5dp">

    <!-- Top Row: Play/Stop Circle + Selected Hz Title + Active Badge -->
    <LinearLayout
        android:id="@+id/qfb_top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qfb_play_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/cosmic_pill_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="#FFD700"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qfb_hz_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9.5sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="432 Hz"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qfb_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cosmic_pill_bg"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="AÇ"
            android:textColor="#FDE68A"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Row: Frequency Name & Status Subtitle -->
    <LinearLayout
        android:id="@+id/qfb_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/cosmic_inner_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/qfb_sub_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="9.5sp"
            android:autoSizeMinTextSize="7.5sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="🎧 Evrensel Rezonans • Dokun &amp; Dinle"
            android:textColor="#D1D5DB"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
